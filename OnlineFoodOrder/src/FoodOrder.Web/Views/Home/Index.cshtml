@model FoodOrder.Web.Models.HomeVm
@{ ViewData["Title"] = "Order Food Online"; }

<!-- ── Hero ──────────────────────────────────────────────────────────── -->
<div class="hero-banner mb-4">
    <div class="container py-5">
        <div class="col-lg-7">
            <h1 class="display-5 fw-bold text-white mb-3">
                Hungry? <span class="text-warning">Order now</span><br/>and eat in 30 min
            </h1>
            <p class="text-white opacity-75 mb-4">South Indian curries · Wood-fired pizza · Dum biryani — delivered fresh.</p>
            <form asp-controller="Home" asp-action="Index" method="get" class="d-flex gap-2">
                <input name="search" value="@Model.Search" class="form-control form-control-lg rounded-pill px-4"
                       placeholder="Search restaurants or cuisines…"/>
                <button class="btn btn-warning btn-lg rounded-pill px-4 fw-bold"><i class="bi bi-search"></i></button>
            </form>
        </div>
    </div>
</div>

<div class="container pb-5">
    <!-- ── Cuisine pills ───────────────────────────────────────────────── -->
    @if (Model.Cuisines.Any())
    {
        <div class="d-flex flex-wrap gap-2 mb-4">
            <a asp-action="Index" class="pill-tag @(string.IsNullOrEmpty(Model.Cuisine) ? "active" : "")">All</a>
            @foreach (var c in Model.Cuisines)
            {
                <a asp-action="Index" asp-route-cuisine="@c"
                   class="pill-tag @(Model.Cuisine == c ? "active" : "")">@c</a>
            }
        </div>
    }

    <!-- ── Active order banner ────────────────────────────────────────── -->
    @{
        var active = Model.RecentOrders.FirstOrDefault(o =>
            o.Status is "Pending" or "Confirmed" or "Preparing" or "OutForDelivery");
    }
    @if (active != null)
    {
        var bc = active.Status == "OutForDelivery" ? "success" : active.Status == "Preparing" ? "warning" : "primary";
        <div class="alert alert-@bc d-flex align-items-center gap-3 mb-4 rounded-3">
            <div class="spinner-border spinner-border-sm"></div>
            <div class="flex-grow-1">
                <strong>Active:</strong> @active.OrderNumber from @active.RestaurantName
                — <span class="badge bg-@bc">@active.Status</span>
            </div>
            <a asp-controller="Order" asp-action="Track" asp-route-id="@active.Id"
               class="btn btn-sm btn-@bc">Track</a>
        </div>
    }

    <!-- ── Restaurant grid ────────────────────────────────────────────── -->
    <h4 class="fw-bold mb-3">
        @(string.IsNullOrEmpty(Model.Cuisine) ? "All Restaurants" : Model.Cuisine)
        <span class="text-muted fw-normal fs-6">(@Model.Restaurants.Count)</span>
    </h4>

    @if (!Model.Restaurants.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-shop display-3 opacity-25"></i>
            <p class="mt-3">No restaurants found. Try a different search.</p>
        </div>
    }

    <div class="row g-4">
        @foreach (var r in Model.Restaurants)
        {
            <div class="col-xl-4 col-lg-6">
                <a asp-controller="Restaurant" asp-action="Menu" asp-route-id="@r.Id"
                   class="resto-card card border-0 shadow-sm text-decoration-none h-100">
                    <div class="resto-img"
                         style="background:linear-gradient(135deg,@(r.Cuisine=="South Indian"?"#f97316,#ef4444":r.Cuisine=="Italian"?"#10b981,#059669":"#8b5cf6,#7c3aed"))">
                        <span class="fs-1 fw-bold text-white opacity-50">@r.Name[0]</span>
                        @if (!r.IsOpen) { <div class="closed-tag">CLOSED</div> }
                        <span class="cuisine-tag">@r.Cuisine</span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 class="fw-bold mb-0 text-dark">@r.Name</h6>
                            <div class="d-flex align-items-center gap-1">
                                <i class="bi bi-star-fill text-warning" style="font-size:.7rem"></i>
                                <span class="small fw-bold text-dark">@r.Rating</span>
                            </div>
                        </div>
                        <p class="text-muted small mb-2 lh-sm">@r.Description</p>
                        <div class="d-flex gap-3 text-muted small">
                            <span><i class="bi bi-clock me-1"></i>@r.DeliveryMins min</span>
                            <span><i class="bi bi-bicycle me-1"></i>₹@r.DeliveryFee</span>
                            <span><i class="bi bi-bag-check me-1"></i>₹@r.MinOrder min</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <!-- ── Recent orders ──────────────────────────────────────────────── -->
    @if (Model.RecentOrders.Any())
    {
        <h4 class="fw-bold mt-5 mb-3">Recent Orders</h4>
        <div class="row g-3">
            @foreach (var o in Model.RecentOrders)
            {
                var sc = o.Status switch { "Delivered"=>"success","Cancelled"=>"danger","OutForDelivery"=>"info",_=>"warning" };
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-semibold small">@o.OrderNumber</span>
                                <span class="badge bg-@sc">@o.Status</span>
                            </div>
                            <div class="small text-muted mb-1"><i class="bi bi-shop me-1"></i>@o.RestaurantName</div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-bold">₹@o.TotalAmount.ToString("N0")</span>
                                <a asp-controller="Order" asp-action="Track" asp-route-id="@o.Id"
                                   class="btn btn-sm btn-outline-primary">Track</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
