@* ── Profile/ChangePassword ──────────────────────────────────────────────── *@
@model FoodOrder.Web.Models.ChangePasswordVm
@{ ViewData["Title"] = "Change Password"; }
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-6">
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0"><h4 class="fw-bold mb-0"><i class="bi bi-shield-lock me-2 text-danger"></i>Change Password</h4></div>
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(Model.Error))
            { <div class="alert alert-danger rounded-3">@Model.Error</div> }
            <form asp-action="ChangePassword" method="post">
                <div class="mb-3">
                    <label asp-for="Current" class="form-label fw-semibold">Current Password</label>
                    <input asp-for="Current" type="password" class="form-control"/>
                    <span asp-validation-for="Current" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="New" class="form-label fw-semibold">New Password</label>
                    <input asp-for="New" type="password" class="form-control"/>
                    <span asp-validation-for="New" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Confirm" class="form-label fw-semibold">Confirm Password</label>
                    <input asp-for="Confirm" type="password" class="form-control"/>
                    <span asp-validation-for="Confirm" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-danger px-4 fw-semibold"><i class="bi bi-shield-check me-2"></i>Update</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div></div></div>
