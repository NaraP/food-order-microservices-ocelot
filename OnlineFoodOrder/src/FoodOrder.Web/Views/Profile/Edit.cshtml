@model FoodOrder.Web.Models.EditProfileVm
@{ ViewData["Title"] = "Edit Profile"; }
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Profile</a></li><li class="breadcrumb-item active">Edit</li></ol>
            </nav>
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0"><h4 class="fw-bold mb-0"><i class="bi bi-person-gear me-2 text-danger"></i>Edit Profile</h4></div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.Error))
                    { <div class="alert alert-danger rounded-3"><i class="bi bi-exclamation-triangle me-2"></i>@Model.Error</div> }
                    <form asp-action="Edit" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold">First Name</label>
                                <input asp-for="FirstName" class="form-control"/>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold">Last Name</label>
                                <input asp-for="LastName" class="form-control"/>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Phone" class="form-label fw-semibold">Phone</label>
                                <input asp-for="Phone" class="form-control"/>
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold">Default Delivery Address</label>
                                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                        <div class="d-flex gap-3 mt-4">
                            <button type="submit" class="btn btn-danger px-4 fw-semibold"><i class="bi bi-check-lg me-2"></i>Save</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
