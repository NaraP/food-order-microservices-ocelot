@model List<FoodOrder.Web.Models.OrderVm>
@{ ViewData["Title"] = "My Orders"; }

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div><h2 class="fw-bold mb-0"><i class="bi bi-bag me-2 text-danger"></i>My Orders</h2><p class="text-muted small mb-0">@Model.Count order(s)</p></div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-danger btn-sm"><i class="bi bi-plus me-1"></i>Order More</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bag display-3 text-muted opacity-25"></i>
            <h5 class="mt-3 text-muted">No orders yet</h5>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-3">Browse Restaurants</a>
        </div>
    }

    <div class="row g-3">
        @foreach (var o in Model)
        {
            var sc = o.Status switch { "Delivered"=>"success","Cancelled"=>"danger","OutForDelivery"=>"info","Preparing"=>"warning",_=>"secondary" };
            var pc = o.PaymentStatus switch { "Paid"=>"success","Failed"=>"danger",_=>"warning" };
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="row align-items-center g-3">
                            <div class="col-md-3">
                                <div class="fw-bold">@o.OrderNumber</div>
                                <div class="text-muted small"><i class="bi bi-shop me-1"></i>@o.RestaurantName</div>
                                <div class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@o.CreatedAt.ToString("MMM dd, hh:mm tt")</div>
                            </div>
                            <div class="col-md-3">
                                @foreach (var item in o.Items.Take(2))
                                { <div class="small">@item.Name × @item.Qty</div> }
                                @if (o.Items.Count > 2) { <div class="text-muted small">+@(o.Items.Count-2) more</div> }
                            </div>
                            <div class="col-md-2">
                                <div class="fw-bold fs-5" style="color:#ef4444">₹@o.TotalAmount.ToString("N0")</div>
                                <span class="badge bg-@pc">@o.PaymentStatus</span>
                            </div>
                            <div class="col-md-2 text-center">
                                <span class="badge bg-@sc fs-6 px-3">@o.Status</span>
                            </div>
                            <div class="col-md-2 text-end d-flex flex-column gap-1">
                                <a asp-action="Track" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-geo-alt me-1"></i>Track</a>
                                @if (o.Status is "Pending" or "Confirmed")
                                {
                                    <form asp-action="Cancel" asp-route-id="@o.Id" method="post"
                                          onsubmit="return confirm('Cancel?')">
                                        <input type="hidden" name="reason" value="Cancelled by customer"/>
                                        <button class="btn btn-sm btn-outline-danger w-100">Cancel</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
