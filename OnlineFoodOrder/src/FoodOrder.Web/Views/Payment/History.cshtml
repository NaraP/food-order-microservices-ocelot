@* ── Payment/History ─────────────────────────────────────────────────────── *@
@model List<FoodOrder.Web.Models.PaymentVm>
@{ ViewData["Title"] = "Payment History"; }
<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div><h2 class="fw-bold mb-0"><i class="bi bi-credit-card me-2 text-danger"></i>Payments</h2><p class="text-muted small mb-0">All transactions</p></div>
    </div>
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-credit-card display-3 text-muted opacity-25"></i>
            <h5 class="mt-3 text-muted">No payments yet</h5>
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-2">Order Now</a>
        </div>
    }
    else
    {
        var totalPaid = Model.Where(p => p.State == "Completed").Sum(p => p.Amount);
        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="card border-0 shadow-sm text-center p-3"><p class="text-muted small fw-semibold text-uppercase mb-1">Total Spent</p><div class="h3 fw-bold" style="color:#ef4444">₹@totalPaid.ToString("N0")</div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm text-center p-3"><p class="text-muted small fw-semibold text-uppercase mb-1">Transactions</p><div class="h3 fw-bold">@Model.Count</div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm text-center p-3"><p class="text-muted small fw-semibold text-uppercase mb-1">Completed</p><div class="h3 fw-bold text-success">@Model.Count(p=>p.State=="Completed")</div></div></div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Transaction ID</th><th>Amount</th><th>Method</th><th>Status</th><th>Date</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.OrderByDescending(x => x.CreatedAt))
                        {
                            var sc = p.State switch { "Completed"=>"success","Failed"=>"danger","Refunded"=>"secondary",_=>"warning" };
                            var mi = p.Method switch { "UPI"=>"bi-phone","Card"=>"bi-credit-card","COD"=>"bi-cash-coin","Wallet"=>"bi-wallet2",_=>"bi-bank" };
                            <tr>
                                <td><code class="small">@p.TransactionId</code></td>
                                <td class="fw-bold" style="color:#ef4444">₹@p.Amount.ToString("N2")</td>
                                <td><span class="badge bg-light text-dark border"><i class="bi @mi me-1"></i>@p.Method</span></td>
                                <td><span class="badge bg-@sc">@p.State</span></td>
                                <td class="small text-muted">@p.CreatedAt.ToString("MMM dd, hh:mm tt")</td>
                                <td><a asp-action="Receipt" asp-route-orderId="@p.OrderId" class="btn btn-sm btn-outline-primary"><i class="bi bi-receipt"></i></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
