@model FoodOrder.Web.Models.LoginVm
@{ Layout = null; ViewData["Title"] = "Sign In"; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>Sign In – QuickBite</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <style>
        body{background:linear-gradient(135deg,#1a1a2e,#16213e,#0f3460);min-height:100vh;}
        .auth-card{border-radius:20px;box-shadow:0 25px 60px rgba(0,0,0,.45);}
        .hero-panel{background:linear-gradient(160deg,#f97316,#ef4444);border-radius:20px 0 0 20px;}
        .form-control{border-radius:10px;padding:.75rem 1rem;border:2px solid #e9ecef;}
        .form-control:focus{border-color:#f97316;box-shadow:0 0 0 .2rem rgba(249,115,22,.15);}
        .btn-primary{background:linear-gradient(135deg,#f97316,#ef4444);border:none;border-radius:10px;padding:.75rem;font-weight:600;}
        .btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(249,115,22,.4);background:linear-gradient(135deg,#f97316,#ef4444);}
        .demo-tag{background:rgba(255,255,255,.12);border-radius:50px;padding:.25rem .75rem;font-size:.78rem;color:rgba(255,255,255,.85);}
    </style>
</head>
<body class="d-flex align-items-center py-5">
<div class="container">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-11">
            <div class="row g-0 auth-card overflow-hidden">
                <!-- Brand panel -->
                <div class="col-lg-5 hero-panel d-none d-lg-flex flex-column p-5 text-white">
                    <div>
                        <div class="fs-2 fw-bold mb-1"><i class="bi bi-basket2-fill me-2"></i>QuickBite</div>
                        <p class="opacity-75 mb-4">Order from the best restaurants in your city</p>
                        <hr class="border-white opacity-25"/>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <span class="demo-tag"><i class="bi bi-lightning-fill me-1"></i>Fast Delivery</span>
                            <span class="demo-tag"><i class="bi bi-shield-check me-1"></i>Secure Pay</span>
                            <span class="demo-tag"><i class="bi bi-star-fill me-1"></i>Top Rated</span>
                        </div>
                    </div>
                    <div class="mt-auto bg-white bg-opacity-10 rounded-3 p-3">
                        <p class="fw-semibold small mb-2">Demo Accounts (password: Food@1234)</p>
                        <p class="small opacity-75 mb-0">rahul@food.com — Customer</p>
                        <p class="small opacity-75 mb-0">admin@food.com — Admin</p>
                        <p class="small opacity-75 mb-0">owner@food.com — RestaurantOwner</p>
                    </div>
                </div>
                <!-- Form panel -->
                <div class="col-lg-7 bg-white p-5">
                    <h2 class="fw-bold mb-1">Welcome back!</h2>
                    <p class="text-muted mb-4">Sign in to order delicious food</p>
                    @if (!string.IsNullOrEmpty(Model.Error))
                    {
                        <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill"></i>@Model.Error
                        </div>
                    }
                    <form asp-action="Login" method="post">
                        <input type="hidden" asp-for="ReturnUrl"/>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="you@email.com" autocomplete="email"/>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••"/>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary text-white w-100 mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>
                    </form>
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <p class="small fw-semibold text-muted mb-2">Quick fill</p>
                        <div class="row g-2">
                            <div class="col-6"><button class="btn btn-outline-danger btn-sm w-100" onclick="fill('rahul@food.com')"><i class="bi bi-person me-1"></i>Customer</button></div>
                            <div class="col-6"><button class="btn btn-outline-dark btn-sm w-100" onclick="fill('admin@food.com')"><i class="bi bi-shield me-1"></i>Admin</button></div>
                            <div class="col-6"><button class="btn btn-outline-warning btn-sm w-100" onclick="fill('owner@food.com')"><i class="bi bi-shop me-1"></i>Owner</button></div>
                            <div class="col-6"><button class="btn btn-outline-success btn-sm w-100" onclick="fill('driver@food.com')"><i class="bi bi-bicycle me-1"></i>Driver</button></div>
                        </div>
                    </div>
                    <p class="text-center text-muted small mb-0">
                        New here? <a asp-controller="Auth" asp-action="Register" class="text-danger fw-semibold text-decoration-none">Create account</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>function fill(e){document.getElementById('Email').value=e;document.getElementById('Password').value='Food@1234';}</script>
</body></html>
